{
  "productName": "Grug Code",
  "version": "0.1.0",
  "identifier": "com.grugcode.app",
  "build": {
    "beforeDevCommand": "bun run tauri:sidecar && bun run dev:client",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Grug Code",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/grug-daemon"
    ]
  }
}
